CONTAINER_PREFIX=tts_ukrainian_

# UID/GID to run the API container as. Optional (default: 1000:1000)
# PUID=1000
# PGID=1000

# Gradio
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_ANALYTICS_ENABLED=True

# HuggingFace Token. Optional
# HF_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# API
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
GRADIO_URL=http://${CONTAINER_PREFIX}gradio:${GRADIO_SERVER_PORT}
AUTO_USE_VERBALIZER=1

# Override package versions in the gradio container (e.g. PyTorch builds
# for older/newer GPUs): create ./${CONTAINER_PREFIX}data/user_requirements.txt
# (visible as /data/user_requirements.txt INSIDE the container) and uncomment.
# See user_requirements.txt.example in the gradio image repo for GPU-specific pins.
# UV_OVERRIDE=/data/user_requirements.txt
# UV_EXTRA_INDEX_URL=https://download.pytorch.org/whl/cu126
